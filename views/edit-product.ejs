<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Product</title>

    <link rel="stylesheet"
          href="/css/stylesheet.css">

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar">

        <h1>Scatch</h1>

        <a href="/owners/admin">
            Back to Admin
        </a>

    </nav>


    <!-- Main -->

    <main class="container">

        <h2>
            Edit Product
        </h2>

        <p class="subtitle">
            Update your product details.
        </p>


        <!-- Edit Form -->

        <form
            action="/products/update/<%= product._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="product-form"
        >


            <!-- Image -->

            <div class="form-group">

                <label>
                    Product Image
                </label>

                <input
                    type="file"
                    name="image"
                    accept="image/*"
                >

            </div>


            <!-- Name -->

            <div class="form-group">

                <label>
                    Product Name
                </label>

                <input
                    type="text"
                    name="name"
                    value="<%= product.name %>"
                    required
                >

            </div>


            <!-- Price + Discount -->

            <div class="form-row">

                <div class="form-group">

                    <label>
                        Price
                    </label>

                    <input
                        type="number"
                        name="price"
                        value="<%= product.price %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Discount
                    </label>

                    <input
                        type="number"
                        name="discount"
                        value="<%= product.discount || 0 %>"
                    >

                </div>

            </div>


            <!-- Colors -->

            <div class="form-row">

                <div class="form-group">

                    <label>
                        Background Color
                    </label>

                    <input
                        type="text"
                        name="bgcolor"
                        value="<%= product.bgcolor %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Panel Color
                    </label>

                    <input
                        type="text"
                        name="panelcolor"
                        value="<%= product.panelcolor %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Text Color
                    </label>

                    <input
                        type="text"
                        name="textcolor"
                        value="<%= product.textcolor %>"
                        required
                    >

                </div>

            </div>


            <!-- Update -->

            <button type="submit">

                Update Product

            </button>


        </form>

    </main>

</body>

</html>