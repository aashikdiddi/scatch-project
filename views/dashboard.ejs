<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Scatch</title>

    <link rel="stylesheet" href="/css/stylesheet.css">

</head>

<body>


    <!-- NAVBAR -->

    <nav class="premium-navbar">

        <a href="/owners/dashboard" class="premium-logo">
            SCATCH
        </a>

        <div class="premium-nav-links">

            <a href="/owners/dashboard" class="active">
                Dashboard
            </a>

            <a href="/owners/admin">
                Products
            </a>

            <a href="/owners/orders">
                Orders
            </a>

            <a href="/users/logout">
                Logout
            </a>

        </div>

    </nav>



    <!-- DASHBOARD -->

    <main class="dashboard-container">


        <!-- HEADER -->

        <div class="dashboard-header">

            <div>

                <p class="premium-label">
                    STORE OVERVIEW
                </p>

                <h1>
                    Dashboard
                </h1>

                <p>
                    Welcome back. Here's what's happening with your store.
                </p>

            </div>


            <a href="/owners/create-product" class="dashboard-add-btn">
                + Add Product
            </a>

        </div>



        <!-- STAT CARDS -->

        <div class="dashboard-stats">


            <!-- PRODUCTS -->

            <div class="dashboard-stat-card">

                <div class="stat-icon">
                    🛍️
                </div>

                <div class="stat-info">

                    <span>
                        Total Products
                    </span>

                    <strong>
                        <%= totalProducts %>
                    </strong>

                </div>

            </div>



            <!-- ORDERS -->

            <div class="dashboard-stat-card">

                <div class="stat-icon">
                    📦
                </div>

                <div class="stat-info">

                    <span>
                        Total Orders
                    </span>

                    <strong>
                        <%= totalOrders %>
                    </strong>

                </div>

            </div>



            <!-- PENDING -->

            <div class="dashboard-stat-card">

                <div class="stat-icon">
                    ⏳
                </div>

                <div class="stat-info">

                    <span>
                        Pending Orders
                    </span>

                    <strong>
                        <%= pendingOrders %>
                    </strong>

                </div>

            </div>



            <!-- DELIVERED -->

            <div class="dashboard-stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div class="stat-info">

                    <span>
                        Delivered Orders
                    </span>

                    <strong>
                        <%= deliveredOrders %>
                    </strong>

                </div>

            </div>


        </div>



        <!-- SALES + QUICK ACTIONS -->

        <div class="dashboard-middle">


            <!-- TOTAL SALES -->

            <div class="dashboard-sales-card">

                <p class="dashboard-card-label">
                    TOTAL SALES
                </p>

                <h2>
                    ₹<%= totalSales %>
                </h2>

                <p>
                    Revenue from delivered orders
                </p>

            </div>



            <!-- QUICK ACTIONS -->

            <div class="dashboard-actions-card">

                <p class="dashboard-card-label">
                    QUICK ACTIONS
                </p>


                <div class="dashboard-actions">

                    <a href="/owners/admin">
                        Manage Products
                        <span>→</span>
                    </a>

                    <a href="/owners/orders">
                        Manage Orders
                        <span>→</span>
                    </a>

                    <a href="/owners/create-product">
                        Create Product
                        <span>→</span>
                    </a>

                </div>

            </div>


        </div>



        <!-- RECENT ORDERS -->

        <section class="recent-orders-section">


            <div class="recent-orders-header">

                <div>

                    <p class="dashboard-card-label">
                        ACTIVITY
                    </p>

                    <h2>
                        Recent Orders
                    </h2>

                </div>


                <a href="/owners/orders">
                    View All →
                </a>

            </div>



            <% if (recentOrders.length === 0) { %>


                <div class="dashboard-empty">

                    <div>
                        📦
                    </div>

                    <h3>
                        No Orders Yet
                    </h3>

                    <p>
                        Customer orders will appear here.
                    </p>

                </div>


            <% } else { %>


                <div class="recent-orders-list">


                    <% recentOrders.forEach(function(order) { %>


                        <div class="recent-order-row">


                            <!-- ORDER -->

                            <div class="recent-order-id">

                                <span>
                                    Order
                                </span>

                                <strong>
                                    #<%= order._id.toString().slice(-8).toUpperCase() %>
                                </strong>

                            </div>



                            <!-- CUSTOMER -->

                            <div class="recent-customer">

                                <span>
                                    Customer
                                </span>

                                <strong>
                                    <%= order.user ? order.user.fullname : "Unknown User" %>
                                </strong>

                            </div>



                            <!-- DATE -->

                            <div class="recent-date">

                                <span>
                                    Date
                                </span>

                                <strong>
                                    <%= new Date(order.orderDate).toLocaleDateString("en-IN") %>
                                </strong>

                            </div>



                            <!-- STATUS -->

                            <div>

                                <span class="recent-status">
                                    <%= order.status %>
                                </span>

                            </div>



                            <!-- AMOUNT -->

                            <div class="recent-amount">

                                <span>
                                    Total
                                </span>

                                <strong>
                                    ₹<%= order.totalAmount %>
                                </strong>

                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </section>


    </main>



    <!-- FOOTER -->

    <footer class="premium-footer">

        <div>

            <h2>
                SCATCH
            </h2>

            <p>
                Style that speaks for you.
            </p>

        </div>

        <p class="footer-copy">
            © 2026 Scatch. All rights reserved.
        </p>

    </footer>


</body>

</html>