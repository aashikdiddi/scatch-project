<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Scatch - Shop</title>

    <link rel="stylesheet" href="/css/stylesheet.css">
</head>

<body>

    <!-- Navbar -->

    <nav class="shop-navbar">

        <div class="brand">
            <h1>Scatch</h1>
        </div>

        <div class="shop-nav-links">

            <a href="/users/shop">
                Shop
            </a>

            <a href="/owners/admin">
                Admin
            </a>

            <a href="/users/logout">
                Logout
            </a>

        </div>

    </nav>


    <!-- Hero Section -->

    <section class="shop-hero">

        <div class="hero-content">

            <p class="hero-small">
                WELCOME TO SCATCH
            </p>

            <h2>
                Discover Your<br>
                <span>Perfect Style</span>
            </h2>

            <p>
                Explore our latest collection and find products
                made for your everyday style.
            </p>

            <a href="#products" class="shop-now-btn">
                Shop Now
            </a>

        </div>

    </section>


    <!-- Products -->

    <main class="shop-container" id="products">

        <div class="shop-heading">

            <div>

                <p class="section-label">
                    OUR COLLECTION
                </p>

                <h2>
                    Latest Products
                </h2>

            </div>

            <p class="product-count">
                <%= products.length %> Products
            </p>

        </div>


        <% if (products.length === 0) { %>

            <div class="shop-empty">

                <h3>
                    No Products Available
                </h3>

                <p>
                    New products will appear here soon.
                </p>

            </div>

        <% } else { %>


            <div class="shop-product-grid">

                <% products.forEach(function(product, index) { %>


                    <!-- Product Card -->

                    <div class="shop-product-card">


                        <!-- Product Image -->

                        <div
                            class="shop-product-image"
                            onclick="openImage('/products/image/<%= product._id %>')"
                        >

                            <img
                                src="/products/image/<%= product._id %>"
                                alt="<%= product.name %>"
                            >

                            <% if (product.discount > 0) { %>

                                <span class="discount-badge">
                                    <%= product.discount %>% OFF
                                </span>

                            <% } %>

                            <span class="image-view-text">
                                Click to view
                            </span>

                        </div>


                        <!-- Product Details -->

                        <div class="shop-product-details">

                            <p class="product-category">
                                SCATCH COLLECTION
                            </p>

                            <h3>
                                <%= product.name %>
                            </h3>


                            <div class="shop-price">

                                <span class="current-price">
                                    ₹<%= product.price %>
                                </span>

                                <% if (product.discount > 0) { %>

                                    <span class="old-price">
                                        ₹<%= Math.round(
                                            product.price /
                                            (1 - product.discount / 100)
                                        ) %>
                                    </span>

                                <% } %>

                            </div>


                            <a
                                href="/users/addtocart/<%= product._id %>"
                                class="add-cart-btn"
                            >
                                Add to Cart
                            </a>

                        </div>

                    </div>


                    <!-- Promotional Banner After Every 4 Products -->

                    <% if ((index + 1) % 4 === 0 && index !== products.length - 1) { %>

                        <section class="shop-promo-banner">

                            <div class="promo-content">

                                <p class="promo-small">
                                    SCATCH EXCLUSIVE
                                </p>

                                <h2>
                                    Upgrade Your<br>
                                    <span>Everyday Style</span>
                                </h2>

                                <p>
                                    Discover fresh styles made for
                                    your everyday look.
                                </p>

                                <a href="#products" class="promo-btn">
                                    Explore Collection
                                </a>

                            </div>

                            <div class="promo-badge">
                                NEW
                            </div>

                        </section>

                    <% } %>


                    <!-- SALE Banner After 8 Products -->

                    <% if ((index + 1) === 8 && index !== products.length - 1) { %>

                        <section class="shop-sale-banner">

                            <div>

                                <p class="sale-small">
                                    LIMITED TIME OFFER
                                </p>

                                <h2>
                                    BIG STYLE.
                                    <span>BIG SAVINGS.</span>
                                </h2>

                                <p>
                                    Grab your favourite products
                                    before the offer ends.
                                </p>

                                <a href="#products" class="sale-btn">
                                    Shop Sale
                                </a>

                            </div>

                            <strong>
                                SALE
                            </strong>

                        </section>

                    <% } %>


                <% }) %>

            </div>

        <% } %>

    </main>


    <!-- Image Popup -->

    <div
        id="imageModal"
        class="image-modal"
        onclick="closeImage()"
    >

        <button
            class="image-close"
            onclick="closeImage()"
        >
            &times;
        </button>

        <img
            id="modalImage"
            src=""
            alt="Product Preview"
            onclick="event.stopPropagation()"
        >

    </div>


    <!-- Footer -->

    <footer class="shop-footer">

        <h2>
            Scatch
        </h2>

        <p>
            Style that speaks for you.
        </p>

        <p class="copyright">
            © 2026 Scatch. All rights reserved.
        </p>

    </footer>


    <!-- Image Popup JavaScript -->

    <script>

        function openImage(imageUrl) {

            const modal = document.getElementById("imageModal");
            const image = document.getElementById("modalImage");

            image.src = imageUrl;

            modal.classList.add("active");

            document.body.style.overflow = "hidden";
        }


        function closeImage() {

            const modal = document.getElementById("imageModal");

            modal.classList.remove("active");

            document.body.style.overflow = "auto";
        }


        document.addEventListener("keydown", function(event) {

            if (event.key === "Escape") {
                closeImage();
            }

        });

    </script>

</body>

</html>

