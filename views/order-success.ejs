<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Confirmed | Scatch</title>

    <link rel="stylesheet" href="/css/stylesheet.css">
</head>

<body>

    <nav class="premium-navbar">

        <a href="/users/shop" class="premium-logo">
            SCATCH
        </a>

        <div class="premium-nav-links">
            <a href="/users/shop">Shop</a>
            <a href="/users/cart">Cart</a>
            <a href="/users/logout">Logout</a>
        </div>

    </nav>


    <main class="order-success-container">

        <div class="order-success-card">

            <div class="success-icon">
                ✓
            </div>

            <p class="success-label">
                ORDER CONFIRMED
            </p>

            <h1>
                Thank You For Your Order!
            </h1>

            <p class="success-message">
                Your order has been placed successfully.
                We will start preparing it shortly.
            </p>

            <div class="success-actions">

                <a href="/users/shop" class="premium-primary-btn">
                    Continue Shopping
                </a>

                <a href="/users/orders" class="success-orders-btn">
                    View My Orders
                </a>

            </div>

        </div>

    </main>


    <footer class="premium-footer">

        <div>
            <h2>SCATCH</h2>
            <p>Style that speaks for you.</p>
        </div>

        <p class="footer-copy">
            © 2026 Scatch. All rights reserved.
        </p>

    </footer>

</body>

</html>